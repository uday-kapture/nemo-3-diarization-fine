# Environment for the training box. Copy, fill in, load:
#
#   cp .env.example .env && chmod 600 .env    # .env is git-ignored: it holds secrets
#   source .env                               # in every new shell / tmux window

# --- MLflow (required: diar-train and diar-evaluate refuse to run without a tracking URI) ---
export MLFLOW_TRACKING_URI="https://mlflow.example.com"
# Auth: username + password (Basic) OR a token (Bearer), not both. Leave the other pair commented out.
export MLFLOW_TRACKING_USERNAME=""
export MLFLOW_TRACKING_PASSWORD=""
# export MLFLOW_TRACKING_TOKEN=""

# --- Hugging Face ---
# Needs gated read access to basis-ai/basis-conversations-1500. Leave commented out to use `uv run hf auth login`;
# set it to keep a later `hf auth switch` from changing the token under a running diar-prepare.
# export HF_TOKEN=""

# --- Google Chat progress messages (optional; unset = none sent) ---
# A space's incoming webhook URL (Apps & integrations -> Webhooks): anyone holding it can post there.
# export GCHAT_WEBHOOK_URL=""
